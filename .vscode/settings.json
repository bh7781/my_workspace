{
  "python.defaultInterpreterPath": "${env:MWSPACE_VENV}\\Scripts\\python.exe",
  "python.terminal.useEnvFile": true,
  "jupyter.jupyterServerType": "local",
  "jupyter.kernels.trusted": [
    "${env:USERPROFILE}\\AppData\\Roaming\\jupyter\\kernels\\mwspace\\kernel.json"
  ],
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.env.windows": {
    "VIRTUAL_ENV": "${env:MWSPACE_VENV}",
    "PATH": "${env:MWSPACE_VENV}\\Scripts;${env:PATH}"
  },
  "terminal.integrated.profiles.windows": {
    "Command Prompt (mwspace)": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/K",
        "${env:MWSPACE_VENV}\\Scripts\\activate.bat"
      ]
    },
    "PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${env:MWSPACE_VENV}\\Scripts\\Activate.ps1'"
      ]
    },
    "PowerShell (mwspace)": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${env:MWSPACE_VENV}\\Scripts\\Activate.ps1"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt (mwspace)"
}
